{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DFY运维平台",
  "version": "0.2.5",
  "identifier": "com.dfy.ops",
  "build": {
    "devUrl": "http://localhost:18720",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DFY运维平台",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:18721 http://127.0.0.1:18721 ws://localhost:18721 ws://127.0.0.1:18721; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    },
    "shortDescription": "DFY运维平台",
    "longDescription": "统一管理 DFY 系列异构服务的智能运维控制台",
    "resources": [
      "resource/jre/**/*"
    ]
  }
}